# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Database (Supabase Postgres — DB only, not Supabase client SDK) ----
# Get this from Supabase → Project Settings → Database → Connection string (URI, "Transaction" pooler recommended)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection, used by Prisma Migrate
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ---- Supabase Storage (files only — resumes, logos) ----
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"   # server-side only, NEVER expose to frontend
SUPABASE_STORAGE_BUCKET="resumes"

# ---- Auth secrets (generate with: openssl rand -base64 48) ----
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- Email (verification OTP / password reset) ----
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="replace-with-smtp-api-key"
MAIL_FROM="TrueHire <no-reply@yourdomain.com>"

# ---- Internal service-to-service auth (must match scoring-service-python's copy) ----
SERVICE_SHARED_SECRET="replace-with-a-third-long-random-string"
SCORING_SERVICE_URL="http://localhost:8000"

# ---- OAuth (optional, Phase 1 decision) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
