# ---- Server ----
PORT=8000
ENVIRONMENT=development

# ---- Database (same Supabase Postgres as backend-node, direct connection) ----
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ---- Internal service-to-service auth (must match backend-node's copy exactly) ----
SERVICE_SHARED_SECRET="replace-with-a-third-long-random-string"

# ---- Allowed clock skew (seconds) for signed-request timestamps ----
SERVICE_SIGNATURE_MAX_AGE_SECONDS=60

# ---- Optional: embeddings/LLM provider for match-score (choose one when implementing Phase 6) ----
OPENAI_API_KEY=""
GROQ_API_KEY=""
